{
  "name": "todo-menubar",
  "productName": "Tomatodo",
  "version": "2.3.9",
  "description": "A local to-do app inspired by Microsoft To Do's feature set, with a first-class macOS menu bar (tray) experience",
  "main": "out/main/index.js",
  "author": "humbertcheung",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/test-rtf.mjs && node scripts/test-counts.mjs",
    "test:backup": "electron scripts/test-backup.mjs",
    "migrate:curiota": "node scripts/migrate-curiota.mjs --wipe"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "cc.humbert.todo-menubar",
    "productName": "Tomatodo",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "trayTemplate.png",
          "trayTemplate@2x.png",
          "icon.png",
          "trayTemplateColor.png",
          "trayTemplateColor@2x.png",
          "tomato-cutout.png"
        ]
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}